{
  "name": "atelie-de-colagem",
  "version": "0.4.0",
  "private": true,
  "description": "Editor de imagens e ferramentas de PDF no navegador: recorte, cole, remova objetos, junte e separe PDFs. Grátis, sem cadastro, e os arquivos nunca saem do aparelho.",
  "license": "FSL-1.1-MIT",
  "author": "Elias Neto · Vértice (https://eliasneto072.github.io/vertice/)",
  "homepage": "https://ateliedecolagem.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasneto072/atelie-de-colagem.git"
  },
  "bugs": {
    "url": "https://github.com/eliasneto072/atelie-de-colagem/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289"
  }
}
